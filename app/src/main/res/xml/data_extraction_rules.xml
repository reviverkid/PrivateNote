<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Protect sensitive encrypted database and tokens from unencrypted cloud backup -->
        <exclude domain="database" path="notes_database" />
        <exclude domain="sharedpref" path="private_workspace_chat_prefs.xml" />
        <exclude domain="sharedpref" path="fcm_token_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="fcm_token_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
